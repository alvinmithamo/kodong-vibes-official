# Safaricom Daraja credentials
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Your BusinessShortCode (Till or Paybill). For Till use Store number.
MPESA_SHORTCODE=
# Public URL that Safaricom calls after STK payment (must be reachable on the internet)
MPESA_CALLBACK_URL=https://your-domain.example.com/api/mpesa/callback

# SMTP for contact form notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Email addresses
CONTACT_TO=you@example.com
CONTACT_FROM=web@your-domain.example.com
